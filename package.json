{
  "name": "baton",
  "version": "0.1.0",
  "description": "AI-Powered Music Mastering, Vocal Recreation & Production Suite",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite --mode electron",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
